{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "betaClean",
  "version": "0.2.0",
  "identifier": "com.betacom.betaclean",
  "build": {
    "beforeDevCommand": "npm run fetch:clamav && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch:clamav && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "betaClean",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Betacom",
    "category": "Utility",
    "shortDescription": "Dọn dẹp ổ đĩa offline",
    "copyright": "Betacom",
    "resources": {
      "resources/clamav/": "clamav/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
